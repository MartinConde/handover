{
  "name": "@handover/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy globalVariable baseLocale --emit-ts-declarations",
    "prebuild": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy globalVariable baseLocale --emit-ts-declarations",
    "build": "vite build",
    "predev": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy globalVariable baseLocale --emit-ts-declarations",
    "dev": "vite build --watch",
    "prefixtures": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy globalVariable baseLocale --emit-ts-declarations",
    "fixtures": "vite dev",
    "pretest": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy globalVariable baseLocale --emit-ts-declarations",
    "test": "vitest run",
    "pretypecheck": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy globalVariable baseLocale --emit-ts-declarations",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@dnd-kit/svelte": "^0.5.0",
    "@handover/core": "workspace:*",
    "@inlang/paraglide-js": "2.25.2",
    "@inlang/paraglide-js-svelte": "1.0.4",
    "@inlang/plugin-message-format": "4.4.4",
    "@inlang/sdk": "3.0.5",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tiptap/core": "^3.30.2",
    "@tiptap/extension-blockquote": "^3.30.2",
    "@tiptap/extension-bold": "^3.30.2",
    "@tiptap/extension-document": "^3.30.2",
    "@tiptap/extension-heading": "^3.30.2",
    "@tiptap/extension-italic": "^3.30.2",
    "@tiptap/extension-link": "^3.30.2",
    "@tiptap/extension-list": "^3.30.2",
    "@tiptap/extension-paragraph": "^3.30.2",
    "@tiptap/extension-text": "^3.30.2",
    "@tiptap/markdown": "^3.30.2",
    "@tiptap/pm": "^3.30.2",
    "jsdom": "^30.0.1",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "vite": "^8.0.0"
  }
}
