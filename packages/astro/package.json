{
  "name": "astro-handover",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "components"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./Blocks.astro": "./components/Blocks.astro",
