{
  "name": "astro-handover",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "components",
    "bin"
  ],
  "bin": {
    "handover": "./bin/handover.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    },
    "./Blocks.astro": "./components/Blocks.astro",
    "./LocaleSwitcher.astro": "./components/LocaleSwitcher.astro",
    "./Markdown.astro": "./components/Markdown.astro"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@handover/cli": "workspace:*",
    "@handover/core": "workspace:*",
    "worker-mailer": "1.2.1"
  },
  "peerDependencies": {
    "astro": "^7.0.0"
  },
  "devDependencies": {
    "@handover/ui": "workspace:*",
    "astro": "^7.2.4",
    "better-auth": "^1.7.1",
    "drizzle-kit": "^0.31.10",
    "miniflare": "^4.20260730.0",
    "vite": "^8.0.0"
  }
}
