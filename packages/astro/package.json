    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.3.7",
    "@handover/core": "workspace:*"
  },
  "peerDependencies": {
    "astro": "^7.0.0"
  },
  "devDependencies": {
    "@handover/ui": "workspace:*",
    "astro": "^7.2.4"
  }
