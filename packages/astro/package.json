{
  "name": "astro-handover",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "components",
    "bin"
  ],
  "bin": {
    "handover": "./bin/handover.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cron": {
      "types": "./dist/cron.d.ts",
      "import": "./dist/cron.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    },
    "./Blocks.astro": "./components/Blocks.astro",
    "./Embed.astro": "./components/Embed.astro",
    "./LocaleSwitcher.astro": "./components/LocaleSwitcher.astro",
    "./Markdown.astro": "./components/Markdown.astro",
    "./Nav.astro": "./components/Nav.astro",
    "./Seo.astro": "./components/Seo.astro"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "fixture:build": "pnpm -w build && pnpm --filter @handover/ui build && astro build --root test/fixture/canvas",
    "fixture:start": "node test/fixture/canvas/dist/server/entry.mjs",
    "test": "vitest run",
    "test:browser": "playwright test",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@handover/cli": "workspace:*",
    "@handover/core": "workspace:*",
    "worker-mailer": "1.2.1"
  },
  "peerDependencies": {
    "astro": "^7.0.0"
  },
  "devDependencies": {
    "@astrojs/node": "^11.1.5",
    "@astrojs/svelte": "^9.0.1",
    "@handover/ui": "workspace:*",
    "@playwright/test": "^1.63.0",
    "astro": "^7.2.4",
    "better-auth": "1.7.1",
    "drizzle-kit": "^0.31.10",
    "miniflare": "^4.20260730.0",
    "svelte": "^5.56.10",
    "vite": "^8.0.0"
  }
}
