---
import { createEditContext } from 'astro-handover';
import Blocks from 'astro-handover/Blocks.astro';
import Markdown from 'astro-handover/Markdown.astro';
import FixtureBlock from './FixtureBlock.astro';
import Island from './Island.svelte';

const { data, locale, globals } = Astro.props;
const components = {
  repeated: FixtureBlock,
  promo: FixtureBlock,
  columns: FixtureBlock,
};
const edit = createEditContext(Astro);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{data.title}</title>
  </head>
  <body>
    <main class="fixture-shell" {...edit.list('blocks')}>
      <h1 {...edit.field('title')}>{data.title}</h1>
      {data.summary && <div data-fixture-summary {...edit.field('summary')}><Markdown content={data.summary} /></div>}
      {data.body && <div data-fixture-body {...edit.field('body')}><Markdown content={data.body} /></div>}
      {data.button && (
        <a
          data-fixture-button
          href={data.button.type === 'url' ? data.button.href : '#'}
          target={data.button.newTab ? '_blank' : undefined}
          {...edit.field('button')}
        >
          {data.button.label}
        </a>
      )}
      {data.legacy && <div data-fixture-legacy {...edit.field('legacy')}><Markdown content={data.legacy} /></div>}
      <Blocks blocks={data.blocks} {components} {globals} edit={edit.list('blocks')} />
      <Island client:load />
    </main>
  </body>
</html>

<style>
  :global(body) {
    margin: 0;
    font-family: system-ui, sans-serif;
  }

  .fixture-shell {
    margin: 2rem auto;
    max-width: 60rem;
    padding: 0 1rem;
  }
</style>
