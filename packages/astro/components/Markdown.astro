---
import { renderRichtext } from '@handover/core';

interface Props {
  content: string;
}

// The HTML is built from the validated tree, never from the file's own markup, so
// `set:html` here cannot emit anything a richtext tier disallows.
const html = renderRichtext('default', Astro.props.content);
---

<Fragment set:html={html} />
