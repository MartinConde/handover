---
// An .astro file because it renders the site's own components; every decision is in `preview()`.
import { getCollection, getEntry } from 'astro:content';
import config from 'virtual:handover/config';
import assets from 'virtual:handover/ui';
import { preview } from '../dist/routes/preview.js';

const result = await preview(Astro, {
  getEntry: async (collection, id) => getEntry(collection, id),
  getCollection: (collection) => getCollection(collection),
});
if (result instanceof Response) return result;
const { Component, props, previewResult, canvasManifest } = result;
const canvas = canvasManifest ? assets.entries.canvas : undefined;
const base = (config.i18n.base ?? '').replace(/\/+$/, '');
const asset = (path: string) => `${base}/admin/_assets/${path}`;
---

<Component {...props} />
{previewResult && (
  <span
    hidden
    data-handover-preview-result={previewResult.status}
    data-handover-preview-url={previewResult.url}
    data-handover-preview-version={previewResult.version}
  ></span>
)}
{canvasManifest && canvas && (
  <>
    {canvas.styles.map((style) => <link rel="stylesheet" href={asset(style)} />)}
    <script type="application/json" data-handover-canvas-manifest set:html={canvasManifest}></script>
    <script is:inline type="module" src={asset(canvas.script)}></script>
  </>
)}
