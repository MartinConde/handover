---
import { EMBED_LABELS, type EmbedValue, embedSrc } from '@handover/core';

interface Props {
  /** What the content file holds: the provider and the id, never a URL and never markup. */
  value?: EmbedValue;
}

const { value } = Astro.props;
// The address is built from the provider's own template and the stored id, so nothing a client
// pasted into the admin can become a frame pointing anywhere else.
const src = value && embedSrc(value);
// A frame with no name is one a screen reader announces as nothing at all, so the provider
// stands in until somebody has typed a title in this language.
const label = value && (value.title || EMBED_LABELS[value.provider]);
---

{src && (
  <div class="handover-embed">
    <iframe src={src} title={label} loading="lazy" allowfullscreen></iframe>
  </div>
)}

<style>
  /* The box is the component's own: a frame that arrives at its size after the page has drawn
     moves everything under it. How it looks otherwise is the site's. */
  .handover-embed { aspect-ratio: 16 / 9; }
  .handover-embed iframe { display: block; width: 100%; height: 100%; border: 0; }
</style>
