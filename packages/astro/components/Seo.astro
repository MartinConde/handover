---
import {
  type LocaleLink,
  resolveSeo,
  type SeoDefaultsValue,
  type SeoValue,
  withSlash,
} from '@handover/core';

interface Props {
  /** The entry's own `seo` field, where it has one. */
  seo?: SeoValue;
  /** What the global holding `defaultSeo` says in this language. */
  defaults?: SeoDefaultsValue;
  /** The page's own heading — what a search title nobody typed falls back to. */
  title?: string;
  /** The site's name, for `og:site_name`. */
  siteName?: string;
  /** The language being rendered. */
  locale?: string;
  /** The languages this entry can be read in: `getEntryLocales()`'s answer. */
  locales?: LocaleLink[];
  /** Where a stored media key is served from — `media.publicBase`. */
  mediaBase?: string;
  /** Where the site is served; without one there is no canonical, `og:url` or alternates. */
  site?: URL | string;
}

const {
  seo,
  defaults,
  title = '',
  siteName,
  locale,
  locales = [],
  mediaBase,
  site = Astro.site,
} = Astro.props;

const tags = resolveSeo(seo, defaults, title);
const at = (path: string) => (site ? new URL(path, site).href : undefined);
const canonical = tags.canonical ?? at(Astro.url.pathname);
// Alternates take this page's own slash convention, or its own hreflang would be a second URL.
const slashed = Astro.url.pathname.endsWith('/');
const like = (path: string) => withSlash(path, slashed);
// A content file holds a key, not a URL; without a base the card goes out without an image.
const image =
  tags.image && mediaBase ? `${mediaBase.replace(/\/$/, '')}/${tags.image.src}` : undefined;
// One language is nothing to alternate between, the rule <LocaleSwitcher /> follows.
const alternates = site && locales.length > 1 ? locales : [];
---

<title>{tags.title}</title>
{tags.description && <meta name="description" content={tags.description} />}
{tags.noindex && <meta name="robots" content="noindex" />}
{canonical && <link rel="canonical" href={canonical} />}
{alternates.map(({ locale: of, url }) => (
  <link rel="alternate" hreflang={of} href={at(like(url))} />
))}

<meta property="og:type" content="website" />
<meta property="og:title" content={tags.title} />
{tags.description && <meta property="og:description" content={tags.description} />}
{canonical && <meta property="og:url" content={canonical} />}
{siteName && <meta property="og:site_name" content={siteName} />}
{locale && <meta property="og:locale" content={locale} />}
{image && <meta property="og:image" content={image} />}
{image && tags.image?.alt && <meta property="og:image:alt" content={tags.image.alt} />}
{image && <meta property="og:image:width" content={String(tags.image?.width)} />}
{image && <meta property="og:image:height" content={String(tags.image?.height)} />}

<meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
{tags.twitter && <meta name="twitter:site" content={tags.twitter} />}
