# Copy to .env.test, then run pnpm --filter @handover/core test:integration.
# The default test command never enables live tests just because this file exists.
# The App must be installed on a private throwaway repo; these tests will commit to it.
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
# PKCS#8 PEM on one line with \n — convert GitHub's download: openssl pkcs8 -topk8 -nocrypt -in key.pem
GITHUB_PRIVATE_KEY=
GITHUB_REPO=owner/handover-throwaway
GITHUB_BRANCH=main
GITHUB_TEST_PATH=README.md
